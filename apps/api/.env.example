# ============================================================================
# Smile Dental SaaS Backend API (@smile/api) — Environment Variables
# Copy to apps/api/.env for local development.
# ============================================================================

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
ENABLE_BULLMQ_WORKER=false

# --- PostgreSQL 16 (Local Docker OR Neon Free) ---
# Local Docker default:
DATABASE_URL=postgresql://smile:smile_dev_password@localhost:5432/smile_db?schema=public
DIRECT_URL=postgresql://smile:smile_dev_password@localhost:5432/smile_db?schema=public

# --- Redis 7 (Local Docker OR Upstash Free) ---
# Local Docker default:
REDIS_URL=redis://localhost:6379

# --- Auth & RBAC (Clerk) ---
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
SUPER_ADMIN_EMAIL=

# --- Internal Cron Security (GitHub Actions -> POST /api/v1/internal/cron/*) ---
CRON_SECRET=

# --- Cloudflare R2 Object Storage ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=smile-private
R2_PUBLIC_BUCKET=smile-public
R2_PUBLIC_BASE_URL=

# --- Transactional Email (Resend OR Gmail SMTP) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Smile Dental <onboarding@resend.dev>
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Smile Dental
