# ============================================================================
# Smile Dental Scheduling System — Monorepo Environment Variables Template
# Copy apps/web/.env.local for Next.js and apps/api/.env for NestJS.
# ============================================================================

# --- Frontend (apps/web/.env.local & Vercel Hobby) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Backend API (apps/api/.env & Render Free) ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://smile:smile_dev_password@localhost:5432/smile_db?schema=public
DIRECT_URL=postgresql://smile:smile_dev_password@localhost:5432/smile_db?schema=public
REDIS_URL=redis://localhost:6379
ENABLE_BULLMQ_WORKER=false

# --- Auth & Super Admin (Clerk) ---
CLERK_WEBHOOK_SECRET=
SUPER_ADMIN_EMAIL=

# --- Internal Cron Security (GitHub Actions -> POST /api/v1/internal/cron/*) ---
CRON_SECRET=

# --- Cloudflare R2 Object Storage ($0 within 10 GB free tier) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=smile-private
R2_PUBLIC_BUCKET=smile-public
R2_PUBLIC_BASE_URL=

# --- Dual Transactional Email (Resend OR Gmail SMTP App Password) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Smile Dental <onboarding@resend.dev>
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Smile Dental
