# ============================================================================
# Smile Dental Scheduling System — Environment Variables Template
# Copy to .env.local for local Next.js development and configure server-side
# secrets in Convex Dashboard -> Settings -> Environment Variables.
# ============================================================================

# --- Next.js & Vercel (.env.local) ---
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Shared (Next.js .env.local & Convex Dashboard) ---
SUPER_ADMIN_EMAIL=

# --- Convex Dashboard Environment Variables ---
CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SECRET=
RESEND_API_KEY=

