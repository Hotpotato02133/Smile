# ============================================================================
# Smile Dental Scheduling System — Environment Variables Template
# Copy to .env.local for local Next.js development and configure server-side
# secrets in Convex Dashboard -> Settings -> Environment Variables.
# ============================================================================

# --- Next.js & Vercel (.env.local) ---
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Shared (Next.js .env.local & Convex Dashboard) ---
SUPER_ADMIN_EMAIL=

# --- Convex Dashboard Environment Variables ---
CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SECRET=
# Email Option A ($0, no custom domain needed — recommended for free setups):
# Enable 2-Step Verification on Gmail and create an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Email Option B (Resend — requires a verified domain in RESEND_FROM_EMAIL to email any recipient):
RESEND_API_KEY=
RESEND_FROM_EMAIL=Smile Dental <onboarding@resend.dev>
# Optional in Convex: lets the webhook mirror role/clinicId into Clerk publicMetadata
CLERK_SECRET_KEY=

